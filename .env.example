# Copiá este archivo como ".env" y completá los valores reales.
# El archivo .env NO se sube al repositorio.

# Puerto donde corre el servidor (ej: 3000)
PORT=

# Cadena de conexión a MongoDB (ej: mongodb://127.0.0.1:27017/shipnow)
MONGODB_URI=

# Entorno de ejecución: development | production | test
NODE_ENV=

# (Opcional) Nivel mínimo de log: debug | http | info | warning | error | fatal
# Si se deja vacío: development = debug, production = info, test = error
LOG_LEVEL=
