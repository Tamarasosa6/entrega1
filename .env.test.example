# Variables del entorno de TESTING (separado del de desarrollo).
# Es opcional: si no existe un archivo ".env.test", los tests usan estos mismos valores por defecto.
# Para personalizar, copiá este archivo como ".env.test" (que no se sube al repositorio).
#
# IMPORTANTE: la base de datos tiene que ser DESCARTABLE y su nombre tiene que contener "test".
# Los tests borran todos los datos de esa base y se niegan a correr contra cualquier otra.

# Puerto (los tests no abren ningún puerto; el valor solo cumple con la validación de la config)
PORT=3001

# Base de datos de testing, distinta de la de desarrollo (shipnow)
MONGODB_URI=mongodb://127.0.0.1:27017/shipnow_test

# El entorno lo fija el propio setup de los tests
NODE_ENV=test
